<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Direct-download (Developer ID) build: hardened runtime, no sandbox.
         The Mac App Store build uses StretchCat-appstore.entitlements instead. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
