<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build: sandboxed. User notifications and SMAppService
         launch-at-login both work inside the sandbox; no network or file
         access is needed. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
